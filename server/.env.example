# ASTRAVIA — ASTRA AI Travel Companion Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ==============================================================================
# AI Provider Configuration
# Set an API key below to enable live conversational AI.
# If no key is set, ASTRA will operate in clearly-identified Local Intelligence
# Demonstration Mode using ASTRAVIA's verified destination and experience catalog.
# ==============================================================================

# Option 1: Google Gemini API (Recommended)
# Obtain a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option 2: OpenAI API
# Obtain a key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Generic fallback parameter
AI_API_KEY=
AI_MODEL=
